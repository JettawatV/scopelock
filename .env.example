# Vertex/ADK runtime configuration. Never commit real credentials.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_GENAI_USE_VERTEXAI=true
SCOPELOCK_MODEL=gemini-3.5-flash
SCOPELOCK_PROMPT_VERSION=requirement_analyzer_v5
SCOPELOCK_SOP_PATH=config/jvl_sop.example.yaml
SCOPELOCK_SCOPE_CONFIDENCE_HIGH=85
SCOPELOCK_SCOPE_CONFIDENCE_MEDIUM=60
SCOPELOCK_SCOPE_CONFIDENCE_LOW=0

# Gmail OAuth and Pub/Sub. Paths may be absolute or repository-relative.
# Keep the real files outside Git; these filenames are ignored by .gitignore.
SCOPELOCK_GMAIL_ACCOUNT=
SCOPELOCK_FIRESTORE_DATABASE=default
SCOPELOCK_GMAIL_CLIENT_SECRET_PATH=secrets/client_secret.json
SCOPELOCK_GMAIL_TOKEN_PATH=secrets/gmail_token.json
# Cloud Run alternative: inject this JSON from Secret Manager; never commit it.
SCOPELOCK_GMAIL_TOKEN_JSON=
SCOPELOCK_GMAIL_PUBSUB_TOPIC=projects/YOUR_PROJECT_ID/topics/scopelock-gmail
SCOPELOCK_PUBSUB_AUDIENCE=
SCOPELOCK_PUBSUB_PUSH_SERVICE_ACCOUNT=
# Required defense-in-depth key for operator commands; use 32+ random characters.
SCOPELOCK_OPERATOR_API_KEY=
# Cloud Run uses an ephemeral path; reviewed commercial bytes remain in Firestore.
SCOPELOCK_ARTIFACT_ROOT=

# Firebase email-link reviewer surface. These are public web configuration
# values, not secrets. The private API verifies every Firebase ID token.
SCOPELOCK_FIREBASE_PROJECT_ID=
SCOPELOCK_FIREBASE_API_KEY=
SCOPELOCK_FIREBASE_AUTH_DOMAIN=

# Only the public reviewer gateway uses this value. It forwards the namespaced
# reviewer API to the private core Cloud Run service with IAM.
SCOPELOCK_PRIVATE_API_URL=
